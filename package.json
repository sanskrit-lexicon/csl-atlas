{
  "name": "csl-atlas",
  "version": "0.1.0",
  "description": "Atlas of the Cologne Digital Sanskrit Lexicons — interactive microstructural analysis",
  "type": "module",
  "license": "CC-BY-SA-4.0",
  "scripts": {
    "dev": "observable preview",
    "test": "node --test",
    "build": "observable build",
    "postbuild": "node -e \"const fs=require('fs');fs.copyFileSync('src/manifest.json', 'dist/manifest.json');fs.copyFileSync('src/sw.js', 'dist/sw.js');fs.copyFileSync('src/favicon.svg', 'dist/favicon.svg');\"",
    "deploy": "observable deploy",
    "build-coverage": "node scripts/build-dictionary-coverage.mjs",
    "build-mw-depth": "node scripts/build-mw-quantitative-depth.mjs",
    "validate-mw-depth": "node scripts/validate-mw-depth.mjs",
    "build-dict-comparison": "node scripts/build-dictionary-comparison.mjs",
    "build-citation-apparatus": "node scripts/build-citation-apparatus.mjs",
    "build-structural-register": "node scripts/build-structural-register.mjs",
    "build-sense-depth": "node scripts/build-sense-depth.mjs",
    "validate-dict-comparison": "node scripts/validate-dictionary-comparison.mjs",
    "build-gender-review": "node scripts/build-gender-conflict-review.mjs",
    "build-source-layer-review": "node scripts/build-source-layer-review.mjs",
    "build-alignment-review": "node scripts/build-alignment-review.mjs",
    "build-semantic-fields": "node scripts/build-semantic-fields.mjs",
    "build-h4-family-profiles": "node scripts/build-h4-family-profiles.mjs",
    "build-xref-lineage": "node scripts/build-xref-lineage.mjs",
    "recover-r2-archive": "node scripts/recover-r2-archive.mjs",
    "build-r2-source-anchors": "node scripts/build-r2-source-anchors.mjs",
    "build-h5-anomaly-review": "node scripts/build-h5-anomaly-review.mjs",
    "validate-review-reports": "node scripts/validate-review-reports.mjs"
  },
  "devDependencies": {
    "@observablehq/framework": "^1.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskrit-lexicon/csl-atlas.git"
  },
  "homepage": "https://sanskrit-lexicon.github.io/csl-atlas/",
  "keywords": [
    "sanskrit",
    "lexicography",
    "microstructure",
    "monier-williams",
    "cdsl",
    "kosha",
    "indology"
  ],
  "author": "CDSL contributors",
  "contributors": [
    "@gasyoun",
    "@funderburkjim",
    "@Andhrabharati"
  ]
}
