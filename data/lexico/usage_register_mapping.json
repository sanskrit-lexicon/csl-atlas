    "register": "usage / stylistic-register labels (Vedic, epic, poetic, figurative, vulgar, ...)",
    "dialect": "language-variety labels marking the form as a dialect/Prākrit/Pāli/New-Indo-Aryan usage",
    "lexicographic": "the lexicographers-only hedge (word attested only in lexica, not in a text)",
    "domain": "subject-field labels the dictionary uses as a usage statement (philosophical, religious, ...)"
  },
