    "reviewed_predicate": {
      "description": "A row is reviewed when items[].reviewStatus is in {reviewed-ok, reviewed-corrected} AND items[].reviewer holds a HUMAN identity. The second half is H1684: agent-attributed rows must not claim human-reviewed. Measured 17-08-2026: 147 rows pass the status half, only 10 pass both -- 130 codex + 7 Antigravity are agent-attributed, so status alone over-claims human review 14.7x. An unrecognised identity reads as NOT human; a genuinely new human reviewer moves the key set, so CI goes red and the census gains the name in the same pass that bumps the pin.",
      "all_of": [
        {
          "field": "reviewStatus",
          "test": "in",
          "values": [
            "reviewed-ok",
            "reviewed-corrected"
          ]
        },
        {
          "field": "reviewer",
          "test": "human_identity",
          "known_human": [
            "gasyoun"
          ],
          "known_agent": [
            "codex",
            "Antigravity"
          ]
        }
      ],
      "source_of_truth": "scripts/lib/review-report.mjs :: HUMAN_STATUSES (:15) + preservation predicate (:27)"
    },
