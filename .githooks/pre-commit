#!/usr/bin/env bash
# >>> token-size-gate (managed block) >>>
# 1 токен = 4 байта; по умолчанию лимит 5000 токенов = 20 000 Б на staged-файл.
# Uninstall: delete this managed block and .githooks/token_size_gate.py.
# Escape hatches: git commit --no-verify (one commit); .token-gate-ignore (reviewed globs).
if command -v python3 >/dev/null 2>&1; then
  python3 "$(dirname "$0")/token_size_gate.py" --staged || exit $?
else
  echo "token-size-gate: python3 не найден — коммит заблокирован (fail-closed)" >&2
  exit 1
fi
# <<< token-size-gate <<<
# Shared-main-tree commit guard — refuse commits made directly in the canonical
# main-tree checkout of this repo; force all local work through a git worktree.
#
# Why: multiple concurrent agent sessions (Claude Code + Codex) share one local
# clone. A direct commit in the shared tree risks the H214 / H685-close intermix,
# where a concurrent session sweeps another session's *staged* changes into its
# own commits. A real git hook is the only enforcement that binds BOTH tools
# identically — neither tool's hook/notify layer sees the other, but both invoke
# real `git commit` through this hooks path. Worktrees share .git/config (so
# core.hooksPath carries into them) but each has its own toplevel, so this never
# fires inside a worktree.
#
# Rolled out 11-07-2026 from the SanskritLexicography/Uprava original.
# Install once per clone:  git config core.hooksPath .githooks
# Escape hatch (solo quick fix, no concurrent-session risk):
#   ALLOW_MAIN_TREE_COMMIT=1 git commit ...

if [ -n "${ALLOW_MAIN_TREE_COMMIT:-}" ]; then
    exit 0
fi

CANONICAL_MAIN_TREE="C:/Users/user/Documents/GitHub/csl-atlas"
toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
norm_toplevel="$(printf '%s' "$toplevel" | tr 'A-Z' 'a-z' | tr '\\' '/')"
norm_canonical="$(printf '%s' "$CANONICAL_MAIN_TREE" | tr 'A-Z' 'a-z' | tr '\\' '/')"

if [ "$norm_toplevel" = "$norm_canonical" ]; then
    echo "" >&2
    echo "BLOCKED: direct commit in the shared main tree of this repo." >&2
    echo "" >&2
    echo "This checkout is used by multiple concurrent sessions (Claude Code +" >&2
    echo "Codex). Committing here risks the H214 / H685-close tree-intermix." >&2
    echo "Do your work in a git worktree instead:" >&2
    echo "" >&2
    echo "  git worktree add -b <branch> ../$(basename "$CANONICAL_MAIN_TREE")-<slug> origin/main" >&2
    echo "  # ...commit in the worktree, then push:" >&2
    echo "  git push origin HEAD:main" >&2
    echo "" >&2
    echo "Deliberate override (solo quick fix, no concurrent-session risk):" >&2
    echo "  ALLOW_MAIN_TREE_COMMIT=1 git commit ..." >&2
    echo "" >&2
    exit 1
fi

# Prose-number drift (H5421) — refuse a NEW stale copy of a pinned number
# (e.g. the union headword count) in a staged Markdown/text file.
staged_md="$(git diff --cached --name-only --diff-filter=ACM -- '*.md' '*.txt' '*.tex')"
if [ -n "$staged_md" ] && [ -f "$(git rev-parse --show-toplevel)/scripts/check_prose_number_drift.py" ]; then
    python3 "$(git rev-parse --show-toplevel)/scripts/check_prose_number_drift.py" --check $staged_md || exit 1
fi

# changelog_queue fragment shape gate (H7467, 30-10-2026) — refuse a
# malformed queue fragment at commit time, while its author is present and
# the fix is one keystroke. PRs #670/#674 repaired eight hand-written
# malformed fragments days after they landed; the release consumer
# (Uprava tools/cut_release.py) only WARNs and skips them at cut time.
# The validator is CONSUMED from the canonical Uprava parser via
# scripts/changelog_queue_shape_gate.py (sibling checkout ../Uprava or
# $UPRAVA_TOOLS) — never copied into this public repo. The gate degrades
# to a loud WARNING + pass when the parser is absent (public clones).
# Escape hatch:  ALLOW_CHANGELOG_QUEUE_SHAPE=1 git commit ...
if [ -z "${ALLOW_CHANGELOG_QUEUE_SHAPE:-}" ]; then
    if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^changelog_queue/.*\.md$'; then
        SHAPE_GATE="$(git rev-parse --show-toplevel)/scripts/changelog_queue_shape_gate.py"
        # python3 can be a Windows Store stub that exists in PATH but cannot
        # run — probe with --version and fall through to `python`.
        SHAPE_PY=""
        for _cand in python3 python; do
            if command -v "$_cand" >/dev/null 2>&1 && "$_cand" --version >/dev/null 2>&1; then
                SHAPE_PY="$_cand"
                break
            fi
        done
        if [ ! -f "$SHAPE_GATE" ]; then
            echo "pre-commit: WARNING changelog_queue shape gate SKIPPED: $SHAPE_GATE missing." >&2
        elif [ -z "$SHAPE_PY" ]; then
            echo "pre-commit: WARNING changelog_queue shape gate SKIPPED: no working python3/python on PATH." >&2
        else
            SHAPE_STATUS=0
            "$SHAPE_PY" "$SHAPE_GATE" --staged || SHAPE_STATUS=$?
            if [ "$SHAPE_STATUS" -ne 0 ]; then
                exit 1
            fi
        fi
    fi
fi

exit 0
